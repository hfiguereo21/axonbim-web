{
  "name": "axonbim-web",
  "private": true,
  "version": "0.0.0",
  "description": "AxonBIM Web — local-first parametric BIM in the browser",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @axonbim/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "check:shortcuts": "node scripts/check-no-test-shortcuts.mjs",
    "check:docs": "node scripts/check-docs-indexed.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:layers": "node scripts/check-layer-purity.mjs",
    "check:coverage": "node scripts/check-workspace-coverage.mjs",
    "check:guards": "node scripts/check-guards-fire.mjs",
    "check:history": "node scripts/check-main-fast-forward.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
